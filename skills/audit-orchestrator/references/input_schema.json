{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditInputContract",
  "type": "object",
  "required": ["site"],
  "properties": {
    "site": {
      "type": "string",
      "format": "uri",
      "description": "Target website URL to audit (e.g. https://example.com)"
    },
    "options": {
      "type": "object",
      "description": "Optional crawl and analysis configurations",
      "properties": {
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
